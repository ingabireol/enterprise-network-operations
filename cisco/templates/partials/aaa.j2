{#- Shared AAA block. TACACS+ with local fallback; the fallback exists so that an
    authentication server outage does not also lock everyone out of the devices
    they need in order to fix it. -#}
! --- AAA -------------------------------------------------------------------
aaa new-model
aaa authentication login default group TACACS_SERVERS local
aaa authentication enable default group TACACS_SERVERS enable
aaa authorization exec default group TACACS_SERVERS local if-authenticated
aaa authorization commands 15 default group TACACS_SERVERS local if-authenticated
aaa accounting exec default start-stop group TACACS_SERVERS
aaa accounting commands 15 default start-stop group TACACS_SERVERS
aaa accounting system default start-stop group TACACS_SERVERS
aaa session-id common
!
aaa group server tacacs+ TACACS_SERVERS
{% for server in aaa.tacacs_servers %}
 server name TACACS_{{ loop.index }}
{% endfor %}
 ip vrf forwarding {{ mgmt_vrf }}
 ip tacacs source-interface {{ mgmt_interface }}
!
{% for server in aaa.tacacs_servers %}
tacacs server TACACS_{{ loop.index }}
 address ipv4 {{ server.address }}
 key 7 {{ server.key_encrypted }}
 timeout 3
{% endfor %}
!
username {{ local_admin.username }} privilege 15 secret 9 {{ local_admin.secret_hash }}
